{
  "tailwindCSS.classFunctions": ["cva", "cx"],
  "workbench.editor.customLabels.patterns": {
    "**/src/app/**/page.tsx": "${dirname} - Page",
    "**/src/app/**/index.tsx": "${dirname} - Index",
    "**/src/app/**/layout.tsx": "${dirname} - Layout",
    "**/src/app/**/template.tsx": "${dirname} - Template",
    // lol
    "**/src/components/**/index.tsx": "${dirname} - Component"
  },
  "workbench.colorCustomizations": {
    "tab.activeBorder": "#3e6db3",
    "statusBar.background": "#31568d",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#3e6db3",
    "statusBarItem.remoteBackground": "#ce7196",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "statusBar.debuggingBackground": "#31568d",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.inactiveBackground": "#31568d"
  },
  "peacock.color": "#31568d",
  "cSpell.words": [
    "anglicare",
    "autorenew",
    "codersforcauses",
    "Cowan",
    "daypicker",
    "debouncer",
    "Ezone",
    "foguwa",
    "foodbank",
    "GEOLOCATE",
    "GUWA",
    "ignitementoring",
    "MAPBOX",
    "mapboxgl",
    "microsoftazure",
    "microsoftsqlserver",
    "MSQL",
    "nextdotjs",
    "nodedotjs",
    "nums",
    "nuqs",
    "Nuxt",
    "nuxtdotjs",
    "overscan",
    "oxfmt",
    "oxlint",
    "oxlintrc",
    "Rugbyworks",
    "snarkdown",
    "srugby",
    "TAFE",
    "thevault",
    "treeify",
    "tsgolint",
    "turbopack",
    "Unban",
    "uuidv",
    "visx",
    "vuedotjs",
    "Vuetify",
    "wadl",
    "wais"
  ],
  "editor.tabSize": 2,
  "editor.tabCompletion": "onlySnippets",
  "eslint.enable": false,
  "oxc.enable": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "oxc.typeAware": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
