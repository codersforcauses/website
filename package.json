{
  "name": "website",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "lint": "oxlint --type-aware",
    "lint:check": "oxlint --type-aware --type-check",
    "format": "oxfmt \"**/*.{ts,tsx,js,jsx,mdx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,mdx}\"",
    "prepare": "node .husky/install.mjs || true",
    "db:up": "drizzle-kit up --config=drizzle-dev.config.ts",
    "db-prod:up": "drizzle-kit up --config=drizzle-prod.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "db-prod:generate": "drizzle-kit generate --config=drizzle-prod.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "db-prod:migrate": "drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:push": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db-prod:push": "drizzle-kit push --config=drizzle-prod.config.ts",
    "db:pull": "drizzle-kit pull --config=drizzle-dev.config.ts",
    "db-prod:pull": "drizzle-kit pull --config=drizzle-prod.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle-dev.config.ts",
    "db-prod:studio": "drizzle-kit studio --config=drizzle-prod.config.ts",
    "preview": "next build && next start",
    "start": "next start",
    "email:dev": "email dev --dir=\"./src/emails\" --port=3030"
  },
